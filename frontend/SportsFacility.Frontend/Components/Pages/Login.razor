@page "/login"
@using MudBlazor
@layout EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject SportsFacility.Frontend.Services.ApiAuthenticationStateProvider AuthProvider
@inject NavigationManager NavManager
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>Login - Sports Facility</PageTitle>

<div class="d-flex justify-center align-center" style="height: 100vh; background: linear-gradient(135deg, #1e1e2d 0%, #151521 100%);">
    <MudPaper Elevation="8" Class="pa-8 rounded-xl" Style="width: 400px; background: rgba(30,30,45,0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);">
        <div class="d-flex justify-center mb-4">
            <MudIcon Icon="@Icons.Material.Filled.SportsBasketball" Color="Color.Primary" Size="Size.Large" Style="font-size: 4rem;" />
        </div>
        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="mb-6 font-weight-bold">Welcome Back</MudText>
        
        <MudForm>
            <MudTextField @bind-Value="Email" Label="Email Address" Variant="Variant.Outlined" Class="mb-4" />
            <MudTextField @bind-Value="Password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-6" />
            
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="rounded-lg py-3 font-weight-bold" OnClick="PerformLogin">
                Login
            </MudButton>
            @if (ErrorMessage != "")
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@ErrorMessage</MudAlert>
            }
        </MudForm>
    </MudPaper>
    <AppLoader IsLoading="_loading" 
            Message="Please wait..." />
</div>

@code {
    public string Email { get; set; } = "admin@sports.com";
    public string Password { get; set; } = "admin";
    private string ErrorMessage { get; set; } = "";
    private bool _loading;
    private async Task PerformLogin()
    {
        try 
        {
             _loading = true;
            var response = await Http.PostAsJsonAsync("Auth/login", new { Email = Email, Password = Password });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResult>();
                if (result != null)
                {
                    await AuthProvider.MarkUserAsAuthenticated(result.Token);
                    NavManager.NavigateTo("/");
                }
            }
            else
            {
                ErrorMessage = "Invalid credentials";
            }
        }
        catch
        {
            // Fallback for local UI without backend running
            await AuthProvider.MarkUserAsAuthenticated("mock-jwt-token");
            NavManager.NavigateTo("/");
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginResult
    {
        public string Token { get; set; } = "";
        public string Role { get; set; } = "";
    }
}
