@page "/activities"
@using MudBlazor
@using SportsFacility.Frontend.Models
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IConfiguration Config
@inject ISnackbar Snackbar

<PageTitle>Sports Activities & Facilities</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Facilities & Activities</MudText>

<MudPaper Class="pa-4 rounded-xl mb-6" Elevation="4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">Configured Activities</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="rounded-lg" OnClick="OpenAddDialog">Add Activity</MudButton>
    </div>
    
    <MudDataGrid Items="@ActivitiesList" Dense="true" Filterable="true" SortMode="SortMode.Multiple">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="ID" />
            <PropertyColumn Property="x => x.Name" Title="Activity / Sport" />
            <TemplateColumn Title="Timings">
                <CellTemplate>
                    @($"{(context.Item.OpenTime.HasValue ? context.Item.OpenTime.Value.ToString(@"hh\:mm") : "06:00")} - {(context.Item.CloseTime.HasValue ? context.Item.CloseTime.Value.ToString(@"hh\:mm") : "22:00")}")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    @if (context.Item.IsActive)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Active</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text">Inactive</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => OpenEditDialog(context.Item)" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudPaper>

<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <DialogContent>
        <MudForm @ref="activityForm">
            <MudTextField @bind-Value="currentActivity.Name" Label="Facility Name" Required="true" Class="mb-3"/>
            <MudTimePicker @bind-Time="currentActivity.OpenTime" Label="Open Time" Required="true" Class="mb-3" />
            <MudTimePicker @bind-Time="currentActivity.CloseTime" Label="Close Time" Required="true" Class="mb-3" />
            <MudSwitch @bind-Value="currentActivity.IsActive" Label="Active" Color="Color.Primary"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<ActivityModel> ActivitiesList = new();
    private List<MembershipModel> MembershipsList = new();

    private MudForm activityForm;
    private MudForm membershipForm;

    protected override async Task OnInitializedAsync()
    {
        if (Config["DataSourceMode"] == "Local")
        {
            ActivitiesList = await Http.GetFromJsonAsync<List<ActivityModel>>($"{NavManager.BaseUri}data/activities.json") ?? new List<ActivityModel>();
            MembershipsList = await Http.GetFromJsonAsync<List<MembershipModel>>($"{NavManager.BaseUri}data/plans.json") ?? new List<MembershipModel>();
        }
        else
        {
            ActivitiesList = await Http.GetFromJsonAsync<List<ActivityModel>>("activities") ?? new List<ActivityModel>();
            MembershipsList = await Http.GetFromJsonAsync<List<MembershipModel>>("plans") ?? new List<MembershipModel>();
        }
    }

    private bool _dialogVisible;
    private ActivityModel currentActivity = new();
    private bool isEdit;
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private void OpenAddDialog()
    {
        currentActivity = new ActivityModel { OpenTime = new TimeSpan(6, 0, 0), CloseTime = new TimeSpan(22, 0, 0), IsActive = true };
        isEdit = false;
        _dialogVisible = true;
    }

    private void OpenEditDialog(ActivityModel act)
    {
        currentActivity = new ActivityModel
        {
            Id = act.Id,
            Name = act.Name,
            Capacity = act.Capacity,
            NumberOfCourts = act.NumberOfCourts,
            OpenTime = act.OpenTime,
            CloseTime = act.CloseTime,
            MaxMembersPerCourt = act.MaxMembersPerCourt,
            IsActive = act.IsActive
        };
        isEdit = true;
        _dialogVisible = true;
    }

    private void Cancel()
    {
        _dialogVisible = false;
    }

    private async Task Save()
    {
        await activityForm.Validate();
        if (activityForm.IsValid)
        {
            // Default backend values that are now removed from UI
            currentActivity.Capacity = 100;
            currentActivity.NumberOfCourts = 1;

            if (Config["DataSourceMode"] == "Api")
            {
                if (isEdit)
                {
                    var response = await Http.PutAsJsonAsync($"activities/{currentActivity.Id}", currentActivity);
                    if (response.IsSuccessStatusCode)
                    {
                        var existing = ActivitiesList.FirstOrDefault(x => x.Id == currentActivity.Id);
                        if (existing != null)
                        {
                            existing.Name = currentActivity.Name;
                            existing.Capacity = currentActivity.Capacity;
                            existing.NumberOfCourts = currentActivity.NumberOfCourts;
                            existing.OpenTime = currentActivity.OpenTime;
                            existing.CloseTime = currentActivity.CloseTime;
                            existing.MaxMembersPerCourt = currentActivity.MaxMembersPerCourt;
                            existing.IsActive = currentActivity.IsActive;
                        }
                        Snackbar.Add("Activity updated successfully", Severity.Success);
                    }
                }
                else
                {
                    var response = await Http.PostAsJsonAsync("activities", currentActivity);
                    if (response.IsSuccessStatusCode)
                    {
                        var created = await response.Content.ReadFromJsonAsync<ActivityModel>();
                        if (created != null)
                        {
                            ActivitiesList.Add(created);
                        }
                        Snackbar.Add("Activity created successfully", Severity.Success);
                    }
                }
            }
            else
            {
                if (isEdit)
                {
                    var existing = ActivitiesList.FirstOrDefault(x => x.Id == currentActivity.Id);
                    if (existing != null)
                    {
                        existing.Name = currentActivity.Name;
                        existing.Capacity = currentActivity.Capacity;
                        existing.NumberOfCourts = currentActivity.NumberOfCourts;
                        existing.OpenTime = currentActivity.OpenTime;
                        existing.CloseTime = currentActivity.CloseTime;
                        existing.MaxMembersPerCourt = currentActivity.MaxMembersPerCourt;
                        existing.IsActive = currentActivity.IsActive;
                    }
                }
                else
                {
                    ActivitiesList.Add(currentActivity);
                }
            }
            _dialogVisible = false;
        }
    }

    private bool _membershipDialogVisible;
    private MembershipModel currentMembership = new();
    private bool isMembershipEdit;

    private void OpenMembershipAddDialog()
    {
        currentMembership = new MembershipModel();
        isMembershipEdit = false;
        _membershipDialogVisible = true;
    }

    private void OpenMembershipEditDialog(MembershipModel mem)
    {
        currentMembership = new MembershipModel
        {
            Id = mem.Id,
            ActivityId = mem.ActivityId,
            Name = mem.Name,
            Type = mem.Type,
            BillingCycle = mem.BillingCycle,
            Price = mem.Price,
            IsCouple = mem.IsCouple,
            IsActive = mem.IsActive
        };
        isMembershipEdit = true;
        _membershipDialogVisible = true;
    }

    private void CancelMembership()
    {
        _membershipDialogVisible = false;
    }

    private async Task SaveMembership()
    {
        await membershipForm.Validate();
        if (membershipForm.IsValid)
        {
            if (Config["DataSourceMode"] == "Api")
            {
                if (string.IsNullOrEmpty(currentMembership.ActivityId) && ActivitiesList.Any())
                {
                    currentMembership.ActivityId = ActivitiesList.First().Id;
                }

                if (isMembershipEdit)
                {
                    var response = await Http.PutAsJsonAsync($"plans/{currentMembership.Id}", currentMembership);
                    if (response.IsSuccessStatusCode)
                    {
                        var existing = MembershipsList.FirstOrDefault(x => x.Id == currentMembership.Id);
                        if (existing != null)
                        {
                            existing.Name = currentMembership.Name;
                            existing.Type = currentMembership.Type;
                            existing.BillingCycle = currentMembership.BillingCycle;
                            existing.Price = currentMembership.Price;
                            existing.IsCouple = currentMembership.Type == "Couple";
                        }
                        Snackbar.Add("Plan updated successfully", Severity.Success);
                    }
                }
                else
                {
                    var response = await Http.PostAsJsonAsync("plans", currentMembership);
                    if (response.IsSuccessStatusCode)
                    {
                        var created = await response.Content.ReadFromJsonAsync<MembershipModel>();
                        if (created != null)
                        {
                            MembershipsList.Add(created);
                        }
                        Snackbar.Add("Plan created successfully", Severity.Success);
                    }
                }
            }
            else
            {
                if (isMembershipEdit)
                {
                    var existing = MembershipsList.FirstOrDefault(x => x.Id == currentMembership.Id);
                    if (existing != null)
                    {
                        existing.Name = currentMembership.Name;
                        existing.Type = currentMembership.Type;
                        existing.BillingCycle = currentMembership.BillingCycle;
                        existing.Price = currentMembership.Price;
                        existing.IsCouple = currentMembership.IsCouple;
                    }
                }
                else
                {
                    currentMembership.Id = "MEM-" + (1000 + MembershipsList.Count).ToString();
                    currentMembership.IsCouple = currentMembership.Type == "Couple";
                    MembershipsList.Add(currentMembership);
                }
            }
            _membershipDialogVisible = false;
        }
    }
}
