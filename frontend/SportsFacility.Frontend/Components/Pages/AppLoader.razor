<MudOverlay Visible="@IsLoading"
            DarkBackground="true"
            ZIndex="9999">

    <div class="loader-wrapper">

        <div class="pulse-icon">
            <MudIcon Icon="@Icons.Material.Filled.SportsCricket"
                     Size="Size.Large"
                     Color="Color.Primary" />
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <MudText Class="mt-3" Color="Color.Primary">
                @Message
            </MudText>
        }

    </div>

</MudOverlay>


@code {

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string Message { get; set; } = string.Empty;

}