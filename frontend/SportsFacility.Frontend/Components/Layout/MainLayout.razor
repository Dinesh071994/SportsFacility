@inherits LayoutComponentBase

<MudThemeProvider Theme="_currentTheme" @bind-IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="0" Style="background: rgba(30, 30, 45, 0.9); backdrop-filter: blur(8px); border-bottom: 1px solid rgba(255,255,255,0.05);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3 font-weight-bold" Color="Color.Primary">SFM<span style="color: white;">PRO</span></MudText>
        <MudSpacer />
        
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleTheme" Class="mr-2" />

        <AuthorizeView>
            <Authorized>
                <MudLink Href="/profile" Style="color: inherit; text-decoration: none;" Class="d-flex align-center mr-4">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="mr-3">
                        @(context.User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                    </MudAvatar>
                    <MudText Typo="Typo.body2" Style="color: white; font-weight: 500;">@context.User.Identity?.Name</MudText>
                </MudLink>
                <MudButton Color="Color.Error" Variant="Variant.Text" Href="/login">Logout</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="rounded-lg" Href="/login">Login</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always" Style="background-color: var(--mud-palette-drawer-background); border-right: 1px solid rgba(255,255,255,0.05);">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Style="background-color: var(--mud-palette-background); min-height: 100vh; display: flex; flex-direction: column;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 pt-4" Style="flex: 1;">
            @Body
        </MudContainer>
        
        <!-- Sticky Footer -->
        <footer style="background: rgba(30, 30, 45, 0.4); border-top: 1px solid rgba(255, 255, 255, 0.05); padding: 1.5rem 0; margin-top: auto; text-align: center;">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                <div class="d-flex flex-column flex-sm-row justify-between align-center px-4">
                    <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.4);">
                        &copy; @DateTime.Now.Year SFM PRO.  All Rights Reserved. 
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.4);" Class="mt-2 mt-sm-0">
                        Software by <a href="https://dineshmahenderkar-portfolio.vercel.app/" target="_blank" style="color: var(--mud-palette-primary); text-decoration: none; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='white'" onmouseout="this.style.color='var(--mud-palette-primary)'">Dinesh</a>
                    </MudText>
                </div>
            </MudContainer>
        </footer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    bool _drawerOpen = true;
    bool _isDarkMode = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    private MudTheme _currentTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#00d2ff",
            Secondary = "#3a7bd5",
            AppbarBackground = "#1e1e2d",
            Background = "#151521",
            Surface = "#1e1e2d",
            DrawerBackground = "#1e1e2d",
            DrawerText = "#92929f",
            DrawerIcon = "#92929f",
            TextPrimary = "#ffffff",
            TextSecondary = "#92929f"
        },
        PaletteLight = new PaletteLight()
        {
            Primary = "#0078d4",
            Secondary = "#2b88d8",
            AppbarBackground = "#f8f9fa",
            Background = "#f4f6f8",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            DrawerText = "#323130",
            DrawerIcon = "#323130",
            TextPrimary = "#323130",
            TextSecondary = "#605e5c"
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "12px",
            DrawerWidthLeft = "260px"
        }
    };
}
